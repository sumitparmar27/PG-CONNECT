# 5000 sits inside a port range Windows/Hyper-V can silently reserve for its own
# NAT (check with `netsh interface ipv4 show excludedportrange protocol=tcp`),
# which makes Node's listen() succeed while every real request 403s. 5050 avoids it.
PORT=5050
MONGO_URI=mongodb://localhost:27017/pg-connect
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# From the Razorpay dashboard (Settings > API Keys). Test-mode keys are fine for dev.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: only needed if you've registered a webhook URL in the Razorpay dashboard
# (Settings > Webhooks) as a production safety net for missed client callbacks.
# RAZORPAY_WEBHOOK_SECRET=

# Percentage of each booking's rent the platform keeps; the rest goes to the owner.
PLATFORM_FEE_PERCENT=5

# Only needed if the client dev server should call a backend on a different origin.
# Leave unset to use the same-origin "/api" path (works via the Vite proxy in dev
# and automatically in production since server.js serves the built client).
# VITE_API_URL=http://localhost:5050/api
